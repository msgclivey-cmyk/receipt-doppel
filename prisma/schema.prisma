generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  brands       Brand[]
}

model Brand {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  domain           String
  tagline          String?
  industry         String
  logoInitials     String
  protectionActive Boolean        @default(true)
  paymentProvider  String?
  paymentConnected Boolean        @default(false)
  paymentAccountId String?
  ownerId          String
  owner            User           @relation(fields: [ownerId], references: [id])
  testimonials     Testimonial[]
  threats          Threat[]
  charges          Charge[]
  reviewInvites    ReviewInvite[]
  createdAt        DateTime       @default(now())
}

model Charge {
  id               String         @id @default(cuid())
  brandId          String
  brand            Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  provider         String
  providerChargeId String
  orderRef         String
  amountCents      Int
  currency         String         @default("USD")
  customerEmail    String
  customerName     String
  status           String         @default("paid")
  paidAt           DateTime       @default(now())
  createdAt        DateTime       @default(now())
  invites          ReviewInvite[]
  testimonial      Testimonial?

  @@unique([brandId, orderRef])
  @@unique([provider, providerChargeId])
}

model ReviewInvite {
  id        String    @id @default(cuid())
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  chargeId  String
  charge    Charge    @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Testimonial {
  id              String   @id @default(cuid())
  brandId         String
  brand           Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  chargeId        String?  @unique
  charge          Charge?  @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  authorName      String
  authorTitle     String?
  authorInitials  String
  authorEmailMask String?
  body            String
  rating          Int      @default(5)
  amountCents     Int
  currency        String   @default("USD")
  provider        String
  orderRef        String
  published       Boolean  @default(true)
  brandSafe       Boolean  @default(true)
  category        String
  createdAt       DateTime @default(now())
}

model Threat {
  id           String   @id @default(cuid())
  brandId      String
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title        String
  type         String
  severity     String
  status       String   @default("open")
  url          String?
  summary      String
  evidenceJson String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
